<template>
  <view class="chat-page" :class="themeClass">
    <em-chat-page
      v-if="conversationId !== ''"
      :conversation-id="conversationId"
      :chat-type="CONVERSATION_TYPE.SINGLE_CHAT"
      :title="peerName"
      :peer-name="peerName"
      :peer-avatar="peerAvatar"
      :show-action="false"
      :show-back="false"
      @unauthorized="onUnauthorized"
    />
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { CONVERSATION_TYPE, EmKit, useTheme } from '@/uni_modules/easemob-uikit-uni/libs'

const { themeClass } = useTheme()
const conversationId = ref('')
const peerName = ref('')
const peerAvatar = ref('')

onLoad((query) => {
  if (EmKit.state.userId === '') {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  conversationId.value = (query?.['conversationId'] ?? '') as string
  peerName.value = (query?.['peerName'] ?? '') as string
  peerAvatar.value = (query?.['peerAvatar'] ?? '') as string
})

function onUnauthorized(): void {
  uni.reLaunch({ url: '/pages/login/login' })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background-color: var(--em-chat-bg);
}
</style>
