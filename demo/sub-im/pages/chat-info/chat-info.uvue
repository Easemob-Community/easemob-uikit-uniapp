<template>
  <view class="page">
    <em-chat-info-page
      v-if="conversationId !== ''"
      :conversation-id="conversationId"
      :chat-type="chatType"
      @back="onBack"
      @deleted="onExitToConversation"
      @leaved="onExitToConversation"
      @chat-member="onChatMember"
    />
  </view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { ref } from 'vue'
import { EmKit, CONNECTION_STATUS, CONVERSATION_TYPE } from '@/uni_modules/easemob-uikit-uni/libs'
import type { ConversationTypeValue } from '@/uni_modules/easemob-uikit-uni/libs'

const conversationId = ref('')
const chatType = ref<ConversationTypeValue>(CONVERSATION_TYPE.SINGLE_CHAT)

onLoad((options) => {
  if (EmKit.state.status !== CONNECTION_STATUS.ONLINE) {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  conversationId.value = (options?.['conversationId'] ?? '') as string
  const type = (options?.['chatType'] ?? '') as string
  chatType.value = type === CONVERSATION_TYPE.GROUP_CHAT ? CONVERSATION_TYPE.GROUP_CHAT : CONVERSATION_TYPE.SINGLE_CHAT
})

// 删除会话/退群/解散后退回会话列表（聊天详情 ← 聊天页 ← 会话列表，delta 2）
function onExitToConversation() {
  uni.navigateBack({ delta: 2 })
}

// 群成员私聊：本地构造单聊会话 + 跳聊天页（邀请入群/成员管理视图已库内闭环，无需接线）
function onChatMember(userId: string) {
  EmKit.addConversation(userId, CONVERSATION_TYPE.SINGLE_CHAT)
  uni.navigateTo({ url: `/sub-im/pages/chat/chat?conversationId=${userId}&chatType=${CONVERSATION_TYPE.SINGLE_CHAT}` })
}

function onBack(): void {
  uni.navigateBack({ delta: 1 })
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}
</style>
