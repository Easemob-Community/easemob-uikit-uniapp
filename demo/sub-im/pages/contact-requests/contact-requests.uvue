<template>
  <view class="page" :class="themeClass">
    <em-contact-requests-page @back="onBack" />
  </view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { EmKit, CONNECTION_STATUS } from '@/uni_modules/easemob-uikit-uni/libs'
import { useDemoTheme } from '@/common/theme'

const { themeClass } = useDemoTheme()

onLoad(() => {
  if (EmKit.state.status !== CONNECTION_STATUS.ONLINE) {
    uni.reLaunch({ url: '/pages/login/login' })
  }
})

function onBack(): void {
  uni.navigateBack({ delta: 1 })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-conversation-list-bg);
}
</style>
