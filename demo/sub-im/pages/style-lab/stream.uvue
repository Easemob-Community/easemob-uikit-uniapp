<template>
  <scroll-view scroll-y :class="['lab', themeClass]">
    <view class="lab__section">
      <text class="lab__section-title">AI 流式消息（光标 / 终态收敛 / 异常提示）</text>
      <view class="lab__actions">
        <button class="lab__btn" @click="startStreamDemo('completed')">开始流式</button>
        <button class="lab__btn" @click="startStreamDemo('error')">异常中断</button>
        <button class="lab__btn" @click="stopStreamDemo">停止</button>
      </view>
      <text class="lab__stream-meta">分片 {{ streamChunks }} · 状态 {{ streamStatusLabel }} · 合批间隔 {{ config.streamThrottle }}ms</text>
      <view class="lab__stream-row">
        <em-avatar name="AI" :size="36" />
        <view class="lab__stream-bubble">
          <em-text-message :message="streamMessage" />
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onUnload } from '@dcloudio/uni-app'
import { useConfig, CONVERSATION_TYPE, STREAM_MESSAGE_STATUS } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmMessageItem, StreamMessageStatusValue } from '@/uni_modules/easemob-uikit-uni/libs'
import { useDemoTheme } from '@/common/theme'
import { AI_STREAM_DEMO_CONTENT, AI_STREAM_ERROR_CONTENT, buildAiMessage, startMockStream } from '@/common/ai-stream-demo'

const { themeClass } = useDemoTheme()

// ===== AI 流式消息演示 =====
// 不依赖 SDK/会话：用通用分片模拟器驱动 em-text-message 的流式展示，
// 演示 cursor / 终态收敛 / ERROR 提示三种状态；真实链路见 docs 与 libs/chat/message.ts。
const { config } = useConfig()
const initialMessage = buildAiMessage('style-lab', CONVERSATION_TYPE.SINGLE_CHAT, 'me')
initialMessage.text = '点击「开始流式」查看 AI 流式输出效果。'
const streamMessage = ref<EmMessageItem>(initialMessage)
const streamChunks = ref(0)
const streamStatus = ref<StreamMessageStatusValue | ''>('')
let stopStream: (() => void) | null = null

const streamStatusLabel = computed(() => {
  switch (streamStatus.value) {
    case STREAM_MESSAGE_STATUS.START: return '开始'
    case STREAM_MESSAGE_STATUS.IN_PROGRESS: return '传输中'
    case STREAM_MESSAGE_STATUS.START_COMPLETED: return '单分片完成'
    case STREAM_MESSAGE_STATUS.COMPLETED: return '完成'
    case STREAM_MESSAGE_STATUS.ERROR: return '异常'
    default: return '待开始'
  }
})

function stopStreamDemo() {
  stopStream?.()
  stopStream = null
}

function startStreamDemo(endStatus: 'completed' | 'error') {
  stopStreamDemo()
  const base = buildAiMessage('style-lab', CONVERSATION_TYPE.SINGLE_CHAT, 'me')
  base.stream = {
    customType: 'text',
    seq: 0,
    status: STREAM_MESSAGE_STATUS.START,
    deltaText: '',
    fullText: '',
    errorType: 0
  }
  streamMessage.value = base
  streamChunks.value = 0
  streamStatus.value = STREAM_MESSAGE_STATUS.START
  stopStream = startMockStream(
    { content: endStatus === 'error' ? AI_STREAM_ERROR_CONTENT : AI_STREAM_DEMO_CONTENT, endStatus },
    (chunk) => {
      streamChunks.value += 1
      streamStatus.value = chunk.stream.status
      const next: EmMessageItem = { ...streamMessage.value, text: chunk.fullText, stream: chunk.stream }
      streamMessage.value = next
      if (chunk.stream.status === STREAM_MESSAGE_STATUS.COMPLETED
        || chunk.stream.status === STREAM_MESSAGE_STATUS.START_COMPLETED
        || chunk.stream.status === STREAM_MESSAGE_STATUS.ERROR) {
        stopStreamDemo()
      }
    }
  )
}

onUnload(() => {
  stopStreamDemo()
})
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.lab {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--em-bg-base);
}

.lab__section {
  display: flex;
  flex-direction: column;
  padding: var(--em-spacing-4);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--em-border-light);
}

.lab__section-title {
  font-size: var(--em-font-size-13);
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-tertiary);
  margin-bottom: var(--em-spacing-3);
}

.lab__actions {
  display: flex;
  flex-direction: row;
}

.lab__btn {
  height: 32px;
  line-height: 32px;
  padding-top: 0;
  padding-bottom: 0;
  padding-left: var(--em-spacing-4);
  padding-right: var(--em-spacing-4);
  margin-right: var(--em-spacing-3);
  font-size: var(--em-font-size-14);
  color: var(--em-text-inverse);
  background-color: var(--em-primary-color);
  border-radius: var(--em-radius);
}

.lab__stream-meta {
  font-size: var(--em-font-size-11);
  color: var(--em-text-tertiary);
  margin-top: var(--em-spacing-3);
  margin-bottom: var(--em-spacing-3);
}

.lab__stream-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* 流式气泡演示：宽度链用 rpx 定宽（蒸汽端多行 text 禁用 % max-width，见坑集 #1） */
.lab__stream-bubble {
  width: 480rpx;
  margin-left: var(--em-spacing-3);
}
</style>
