<template>
  <scroll-view scroll-y :class="['lab', themeClass]">
    <view class="lab__section">
      <text class="lab__section-title">em-avatar</text>
      <view class="lab__avatars">
        <!-- em-avatar 是 virtualHost：布局 class 落普通 view 包裹（mp 宿主类失效，坑集 §8a）；
             包裹层与行容器都要 overflow: visible——徽标负偏移探出头像盒，蒸汽端 view 默认 overflow:hidden 会裁 -->
        <view class="lab__avatar-item"><em-avatar name="环信" :size="64" :badge="3" /></view>
        <view class="lab__avatar-item"><em-avatar name="Neo" :size="48" shape="square" :badge="120" /></view>
        <view class="lab__avatar-item"><em-avatar name="张小龙" :size="40" :badge-dot="true" /></view>
        <view class="lab__avatar-item"><em-avatar name="UIKit" :size="32" /></view>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-icon（vue icons-v2 同款字形全量字体）</text>
      <view class="lab__icons">
        <view v-for="icon in iconNames" :key="icon" class="lab__icon-item">
          <em-icon :name="icon" :size="24" />
          <text class="lab__icon-name">{{ icon }}</text>
        </view>
        <view class="lab__icon-item">
          <em-icon name="plane" :size="24" color="#07c160" />
          <text class="lab__icon-name">custom color</text>
        </view>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-multi-body-message（复合消息：单气泡有序多段）</text>
      <view class="lab__multi-body">
        <em-multi-body-message :message="multiBodyMessage" />
      </view>
      <view class="lab__multi-body lab__multi-body--self">
        <em-multi-body-message :message="multiBodySelfMessage" />
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-empty（空状态：normal / small / large）</text>
      <em-empty icon="list-bullet" :description="t('conversation.empty')" />
      <em-empty icon="search" size="small" :description="t('conversation.searchEmpty')" />
      <em-empty icon="bubble-rect-2" size="large" :title="t('chat.title')" :description="t('chat.noMessages')" />
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-skeleton（骨架屏：静态灰块）</text>
      <view class="lab__skeleton-item">
        <em-skeleton variant="avatar" shape="rounded" width="48px" height="48px" />
        <view class="lab__skeleton-lines">
          <em-skeleton width="40%" />
          <em-skeleton class="lab__skeleton-line-sub" width="70%" />
        </view>
      </view>
      <em-skeleton class="lab__skeleton-block" />
      <em-skeleton variant="paragraph" :rows="3" />
    </view>
</scroll-view>
</template>

<script setup lang="ts">
import { MESSAGE_TYPE, useLocale } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmMessageItem } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'
import { useDemoTheme } from '@/common/theme'

const { themeClass } = useDemoTheme()
const { t } = useLocale()

function demoSegment(type: EmMessageItem['type'], localId: string, patch: Partial<EmMessageItem> = {}): EmMessageItem {
  return {
    id: '', localId, conversationId: 'style-lab', chatType: 'singleChat', type,
    text: '', url: '', thumbUrl: '', originalUrl: '', isGif: false, width: 0, height: 0,
    time: 0, from: 'designer', to: 'me', self: false, status: 'sent', quote: null,
    duration: 0, fileName: '', fileSize: 0, ext: {}, rawType: '', customEvent: '', customParams: {},
    ...patch
  }
}

const multiBodyMessage: EmMessageItem = demoSegment(MESSAGE_TYPE.MULTI_BODY, 'multi-body-demo', {
  text: '请看设计稿\n第三版已更新',
  segments: [
    demoSegment(MESSAGE_TYPE.TEXT, 'multi-body-demo:0', { text: '请看设计稿，图片与后续内容保持在同一个气泡内。' }),
    demoSegment(MESSAGE_TYPE.IMAGE, 'multi-body-demo:1', {
      url: 'https://picsum.photos/480/320', thumbUrl: 'https://picsum.photos/480/320', width: 480, height: 320
    }),
    demoSegment(MESSAGE_TYPE.TEXT, 'multi-body-demo:2', { text: '第三版已更新' }),
    demoSegment(MESSAGE_TYPE.FILE, 'multi-body-demo:3', {
      url: 'https://example.com/spec.pdf', fileName: 'multi-body-design-spec.pdf', fileSize: 2048
    }),
    demoSegment(MESSAGE_TYPE.AUDIO, 'multi-body-demo:4', { url: 'https://example.com/voice.amr', duration: 3 }),
    demoSegment(MESSAGE_TYPE.VIDEO, 'multi-body-demo:5', {
      url: 'https://www.w3schools.com/html/mov_bbb.mp4', thumbUrl: 'https://picsum.photos/240/160',
      duration: 8, width: 640, height: 360
    }),
    demoSegment(MESSAGE_TYPE.LOCATION, 'multi-body-demo:6', {
      latitude: 31.2304, longitude: 121.4737, address: '上海市徐汇区', buildingName: '环信'
    }),
    demoSegment(MESSAGE_TYPE.CUSTOM, 'multi-body-demo:7', { customEvent: 'userCard', customParams: { userId: 'user-1' } })
  ]
})
const multiBodySelfMessage: EmMessageItem = {
  ...multiBodyMessage,
  localId: 'multi-body-demo-self',
  self: true,
  segments: multiBodyMessage.segments?.map((segment, index) => ({
    ...segment,
    localId: `multi-body-demo-self:${index}`,
    self: true
  }))
}

// 与 vue icons-v2 同名的规范键（非旧版 uni-icons 别名），用于字体走查
const iconNames: EmIconName[] = [
  'chevron-left', 'search', 'plus', 'mic', 'rect-img', 'camera', 'doc', 'plane',
  'speaker-wave', 'video', 'check-single', 'circle-bang', 'arrow-down-tray', 'circle-ellipsis', 'trash', 'arrow-lft-uturn'
]
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.lab {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--em-bg-base);
}

.lab__section {
  display: flex;
  flex-direction: column;
  padding: var(--em-spacing-4);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--em-border-light);
}

.lab__section-title {
  font-size: var(--em-font-size-13);
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-tertiary);
  margin-bottom: var(--em-spacing-3);
}

.lab__avatars {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 徽标负偏移探出头像盒：蒸汽端祖先 view 默认 overflow:hidden 会把探出部分切成平顶（em-avatar 根本身已显式放行） */
  overflow: visible;
}

.lab__avatar-item {
  margin-right: var(--em-spacing-4);
  overflow: visible;
}

.lab__icons {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.lab__icon-item {
  width: 72px;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--em-spacing-3);
}

.lab__icon-name {
  font-size: var(--em-font-size-10);
  color: var(--em-text-tertiary);
  margin-top: var(--em-spacing-1);
}

.lab__skeleton-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--em-spacing-4);
}

.lab__skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: var(--em-spacing-3);
}

.lab__skeleton-line-sub {
  margin-top: var(--em-spacing-2);
}

.lab__skeleton-block {
  margin-bottom: var(--em-spacing-4);
}

.lab__multi-body {
  display: flex;
  width: 480rpx;
  margin-bottom: var(--em-spacing-3);
}

.lab__multi-body--self {
  align-self: flex-end;
}
</style>
