      <view class="lab__swatches">
        <view class="lab__swatch lab__swatch--base"><text class="lab__swatch-label">bg-base</text></view>
        <view class="lab__swatch lab__swatch--secondary"><text class="lab__swatch-label">bg-secondary</text></view>
        <view class="lab__swatch lab__swatch--tertiary"><text class="lab__swatch-label">bg-tertiary</text></view>
        <view class="lab__swatch lab__swatch--control"><text class="lab__swatch-label">control-bg</text></view>
        <view class="lab__swatch lab__swatch--active"><text class="lab__swatch-label">bg-active</text></view>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">气泡与徽标色</text>
      <view class="lab__swatches">
        <view class="lab__swatch lab__swatch--bubble-self"><text class="lab__swatch-label lab__swatch-label--light">bubble-self</text></view>
        <view class="lab__swatch lab__swatch--bubble-other"><text class="lab__swatch-label">bubble-other</text></view>
        <view class="lab__swatch lab__swatch--primary"><text class="lab__swatch-label lab__swatch-label--light">primary</text></view>
        <view class="lab__swatch lab__swatch--badge"><text class="lab__swatch-label lab__swatch-label--light">badge</text></view>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">间距阶梯（4/8/12/16/24/32/48）</text>
      <view class="lab__bar lab__bar--s1"></view>
      <view class="lab__bar lab__bar--s2"></view>
      <view class="lab__bar lab__bar--s3"></view>
      <view class="lab__bar lab__bar--s4"></view>
      <view class="lab__bar lab__bar--s5"></view>
      <view class="lab__bar lab__bar--s6"></view>
      <view class="lab__bar lab__bar--s7"></view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">字号阶梯</text>
      <text class="lab__fs lab__fs--10">10px {{ t('message.status.read') }}</text>
      <text class="lab__fs lab__fs--12">12px {{ t('message.action.recall') }}</text>
      <text class="lab__fs lab__fs--14">14px {{ t('chat.placeholder') }}</text>
      <text class="lab__fs lab__fs--16">16px {{ t('chat.title') }}</text>
      <text class="lab__fs lab__fs--20">20px {{ t('button.confirm') }}</text>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-avatar</text>
      <view class="lab__avatars">
        <em-avatar class="lab__avatar-item" name="环信" :size="64" :badge="3" />
        <em-avatar class="lab__avatar-item" name="Neo" :size="48" shape="square" :badge="120" />
        <em-avatar class="lab__avatar-item" name="张小龙" :size="40" :badge-dot="true" />
        <em-avatar class="lab__avatar-item" name="UIKit" :size="32" />
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-icon（vue icons-v2 同款字形全量字体）</text>
      <view class="lab__icons">
        <view v-for="icon in iconNames" :key="icon" class="lab__icon-item">
          <em-icon :name="icon" :size="24" />
          <text class="lab__icon-name">{{ icon }}</text>
        </view>
        <view class="lab__icon-item">
          <em-icon name="plane" :size="24" color="#07c160" />
          <text class="lab__icon-name">custom color</text>
        </view>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-empty（空状态：normal / small / large）</text>
      <em-empty icon="list-bullet" :description="t('conversation.empty')" />
      <em-empty icon="search" size="small" :description="t('conversation.searchEmpty')" />
      <em-empty icon="bubble-rect-2" size="large" :title="t('chat.title')" :description="t('chat.noMessages')" />
    </view>

    <view class="lab__section">
      <text class="lab__section-title">em-skeleton（骨架屏：静态灰块）</text>
      <view class="lab__skeleton-item">
        <em-skeleton variant="avatar" shape="rounded" width="48px" height="48px" />
        <view class="lab__skeleton-lines">
          <em-skeleton width="40%" />
          <em-skeleton class="lab__skeleton-line-sub" width="70%" />
        </view>
      </view>
      <em-skeleton class="lab__skeleton-block" />
      <em-skeleton variant="paragraph" :rows="3" />
    </view>

    <view class="lab__section">
      <text class="lab__section-title">AI 流式消息（光标 / 终态收敛 / 异常提示）</text>
      <view class="lab__actions">
        <button class="lab__btn" @click="startStreamDemo('completed')">开始流式</button>
        <button class="lab__btn" @click="startStreamDemo('error')">异常中断</button>
        <button class="lab__btn" @click="stopStreamDemo">停止</button>
      </view>
      <text class="lab__stream-meta">分片 {{ streamChunks }} · 状态 {{ streamStatusLabel }} · 合批间隔 {{ config.streamThrottle }}ms</text>
      <view class="lab__stream-row">
        <em-avatar name="AI" :size="36" />
        <view class="lab__stream-bubble">
          <em-text-message :message="streamMessage" />
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onUnload } from '@dcloudio/uni-app'
import { useConfig, useLocale, themeStore, CONVERSATION_TYPE, LOCALE, STREAM_MESSAGE_STATUS, THEME_MODE } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmMessageItem, EmThemePreference, StreamMessageStatusValue } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'
import { useDemoTheme } from '@/common/theme'
import { AI_STREAM_DEMO_CONTENT, AI_STREAM_ERROR_CONTENT, buildAiMessage, startMockStream } from '@/common/ai-stream-demo'

// 与「我的」页共用同一主题偏好：auto 跟随系统 / light / dark
const { themeClass, setTheme } = useDemoTheme()
const { t, setLocale } = useLocale()

const THEME_PREFERENCE_ORDER: EmThemePreference[] = [THEME_MODE.AUTO, THEME_MODE.LIGHT, THEME_MODE.DARK]
const themeLabel = computed(() => {
  if (themeStore.preference === THEME_MODE.AUTO) {
    return `跟随系统（当前${themeStore.mode === THEME_MODE.DARK ? '深色' : '浅色'}）`
  }
  return themeStore.preference === THEME_MODE.DARK ? '深色' : '浅色'
})

// ===== AI 流式消息演示 =====
// 不依赖 SDK/会话：用通用分片模拟器驱动 em-text-message 的流式展示，
// 演示 cursor / 终态收敛 / ERROR 提示三种状态；真实链路见 docs 与 libs/chat/message.ts。
const { config } = useConfig()
const initialMessage = buildAiMessage('style-lab', CONVERSATION_TYPE.SINGLE_CHAT, 'me')
initialMessage.text = '点击「开始流式」查看 AI 流式输出效果。'
const streamMessage = ref<EmMessageItem>(initialMessage)
const streamChunks = ref(0)
const streamStatus = ref<StreamMessageStatusValue | ''>('')
let stopStream: (() => void) | null = null

const streamStatusLabel = computed(() => {
  switch (streamStatus.value) {
    case STREAM_MESSAGE_STATUS.START: return '开始'
    case STREAM_MESSAGE_STATUS.IN_PROGRESS: return '传输中'
    case STREAM_MESSAGE_STATUS.START_COMPLETED: return '单分片完成'
    case STREAM_MESSAGE_STATUS.COMPLETED: return '完成'
    case STREAM_MESSAGE_STATUS.ERROR: return '异常'
    default: return '待开始'
  }
})

function stopStreamDemo() {
  stopStream?.()
  stopStream = null
}

function startStreamDemo(endStatus: 'completed' | 'error') {
  stopStreamDemo()
  const base = buildAiMessage('style-lab', CONVERSATION_TYPE.SINGLE_CHAT, 'me')
  base.stream = {
    customType: 'text',
    seq: 0,
    status: STREAM_MESSAGE_STATUS.START,
    deltaText: '',
    fullText: '',
    errorType: 0
  }
  streamMessage.value = base
  streamChunks.value = 0
  streamStatus.value = STREAM_MESSAGE_STATUS.START
  stopStream = startMockStream(
    { content: endStatus === 'error' ? AI_STREAM_ERROR_CONTENT : AI_STREAM_DEMO_CONTENT, endStatus },
    (chunk) => {
      streamChunks.value += 1
      streamStatus.value = chunk.stream.status
      const next: EmMessageItem = { ...streamMessage.value, text: chunk.fullText, stream: chunk.stream }
      streamMessage.value = next
      if (chunk.stream.status === STREAM_MESSAGE_STATUS.COMPLETED
        || chunk.stream.status === STREAM_MESSAGE_STATUS.START_COMPLETED
        || chunk.stream.status === STREAM_MESSAGE_STATUS.ERROR) {
        stopStreamDemo()
      }
    }
  )
}

onUnload(() => {
  stopStreamDemo()
})

// 与 vue icons-v2 同名的规范键（非旧版 uni-icons 别名），用于字体走查
const iconNames: EmIconName[] = [
  'chevron-left', 'search', 'plus', 'mic', 'rect-img', 'camera', 'doc', 'plane',
  'speaker-wave', 'video', 'check-single', 'circle-bang', 'arrow-down-tray', 'circle-ellipsis', 'trash', 'arrow-lft-uturn'
]

function cycleTheme() {
  const index = THEME_PREFERENCE_ORDER.indexOf(themeStore.preference)
  setTheme(THEME_PREFERENCE_ORDER[(index + 1) % THEME_PREFERENCE_ORDER.length])
}

function toggleLocale() {
  setLocale(themeStore.locale === LOCALE.ZH_CN ? LOCALE.EN : LOCALE.ZH_CN)
}
</script>

