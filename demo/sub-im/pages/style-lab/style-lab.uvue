<template>
  <scroll-view scroll-y :class="['lab', themeClass]">
    <view class="lab__header">
      <text class="lab__title">样式实验室 Style Lab</text>
      <text class="lab__subtitle">设计变量、原子组件与定制机制的专项演示，主题与中英切换对全部子页生效</text>
      <view class="lab__actions">
        <button class="lab__btn" @click="cycleTheme">主题：{{ themeLabel }}</button>
        <button class="lab__btn" @click="toggleLocale">{{ themeStore.locale === LOCALE.ZH_CN ? 'English' : '中文' }}</button>
      </view>
    </view>

    <view class="lab__list">
      <view
        v-for="entry in ENTRIES"
        :key="entry.path"
        class="lab__card"
        @click="openEntry(entry.path)"
      >
        <view class="lab__card-icon" :style="'background-color: ' + entry.accent + ';'">
          <em-icon :name="entry.icon" :size="22" color="#FFFFFF" />
        </view>
        <view class="lab__card-main">
          <text class="lab__card-name">{{ entry.name }}</text>
          <text class="lab__card-desc">{{ entry.desc }}</text>
        </view>
        <text class="lab__card-arrow">›</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { LOCALE, THEME_MODE, useLocale, themeStore } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmThemePreference } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'
import { useDemoTheme } from '@/common/theme'

// 与「我的」页共用同一主题偏好：auto 跟随系统 / light / dark；themeStore 全局，子页自动跟随
const { themeClass, setTheme } = useDemoTheme()
const { setLocale } = useLocale()

interface LabEntry {
  path: string
  name: string
  desc: string
  icon: EmIconName
  accent: string
}

const ENTRIES: LabEntry[] = [
  {
    path: '/sub-im/pages/style-lab/tokens',
    name: '设计变量',
    desc: '文字 / 背景 / 气泡色 / 间距 / 字号五组阶梯走查',
    icon: 'rect-hanzinalpha',
    accent: '#33B1FF'
  },
  {
    path: '/sub-im/pages/style-lab/components',
    name: '原子组件',
    desc: 'em-avatar / em-icon / em-empty / em-skeleton',
    icon: 'rects',
    accent: '#7A6FF0'
  },
  {
    path: '/sub-im/pages/style-lab/theming',
    name: '主题定制',
    desc: '运行时主题色（色相条拖拽）+ 子树气泡变量定制',
    icon: 'circle-3bars',
    accent: '#FF6B00'
  },
  {
    path: '/sub-im/pages/style-lab/overrides',
    name: '覆盖机制',
    desc: 'custom-style / custom-class / 变量覆盖 + 五端探针',
    icon: 'console',
    accent: '#0E9F6E'
  },
  {
    path: '/sub-im/pages/style-lab/stream',
    name: 'AI 流式演示',
    desc: '流式气泡：光标 / 终态收敛 / 异常提示，无需登录',
    icon: 'voice-motion-01',
    accent: '#F43F5E'
  },
  {
    path: '/sub-im/pages/style-lab/states',
    name: '通用提交态与错误态',
    desc: 'Switch 状态 / 按钮 loading / 触底错误重试 / 选人提交态',
    icon: 'circle-bang',
    accent: '#EAB308'
  }
]

function openEntry(path: string): void {
  uni.navigateTo({ url: path })
}

const THEME_PREFERENCE_ORDER: EmThemePreference[] = [THEME_MODE.AUTO, THEME_MODE.LIGHT, THEME_MODE.DARK]
const themeLabel = computed(() => {
  if (themeStore.preference === THEME_MODE.AUTO) {
    return `跟随系统（当前${themeStore.mode === THEME_MODE.DARK ? '深色' : '浅色'}）`
  }
  return themeStore.preference === THEME_MODE.DARK ? '深色' : '浅色'
})

function cycleTheme() {
  const index = THEME_PREFERENCE_ORDER.indexOf(themeStore.preference)
  setTheme(THEME_PREFERENCE_ORDER[(index + 1) % THEME_PREFERENCE_ORDER.length])
}

function toggleLocale() {
  setLocale(themeStore.locale === LOCALE.ZH_CN ? LOCALE.EN : LOCALE.ZH_CN)
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.lab {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--em-bg-base);
}

.lab__header {
  display: flex;
  flex-direction: column;
  padding: var(--em-spacing-4);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--em-border-color);
}

.lab__title {
  font-size: var(--em-font-size-18);
  font-weight: var(--em-font-weight-semibold);
  color: var(--em-text-primary);
}

.lab__subtitle {
  font-size: var(--em-font-size-12);
  color: var(--em-text-tertiary);
  margin-top: var(--em-spacing-2);
}

.lab__actions {
  display: flex;
  flex-direction: row;
  margin-top: var(--em-spacing-3);
}

.lab__btn {
  height: 32px;
  line-height: 32px;
  padding-top: 0;
  padding-bottom: 0;
  padding-left: var(--em-spacing-4);
  padding-right: var(--em-spacing-4);
  margin-right: var(--em-spacing-3);
  font-size: var(--em-font-size-14);
  color: var(--em-text-inverse);
  background-color: var(--em-primary-color);
  border-radius: var(--em-radius);
}

.lab__list {
  display: flex;
  flex-direction: column;
  padding: var(--em-spacing-4);
}

.lab__card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--em-spacing-3);
  margin-bottom: var(--em-spacing-3);
  background-color: var(--em-bg-secondary);
  border-radius: var(--em-radius);
}

.lab__card-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--em-radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lab__card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: var(--em-spacing-3);
}

.lab__card-name {
  font-size: var(--em-font-size-16);
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-primary);
}

.lab__card-desc {
  font-size: var(--em-font-size-12);
  color: var(--em-text-tertiary);
  margin-top: var(--em-spacing-1);
}

.lab__card-arrow {
  font-size: var(--em-font-size-20);
  color: var(--em-text-tertiary);
}
</style>
