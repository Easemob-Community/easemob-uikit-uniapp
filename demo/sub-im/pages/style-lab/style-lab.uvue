<template>
  <scroll-view scroll-y :class="['lab', themeClass]">
    <view class="lab__header">
      <text class="lab__title">样式实验室 Style Lab</text>
      <view class="lab__actions">
        <button class="lab__btn" @click="cycleTheme">主题：{{ themeLabel }}</button>
        <button class="lab__btn" @click="toggleLocale">{{ themeStore.locale === LOCALE.ZH_CN ? 'English' : '中文' }}</button>
      </view>
    </view>

    <view class="lab__section">
      <text class="lab__section-title">文字阶梯</text>
      <text class="lab__text lab__text--primary">text-primary · {{ t('conversation.title') }}</text>
      <text class="lab__text lab__text--secondary">text-secondary · {{ t('status.reconnecting') }}</text>
      <text class="lab__text lab__text--tertiary">text-tertiary · {{ t('message.status.sending') }}</text>
      <view class="lab__inverse-box">
        <text class="lab__text lab__text--inverse">text-inverse · {{ t('chat.send') }}</text>
      </view>
    </view>

    <view class="lab__section">
