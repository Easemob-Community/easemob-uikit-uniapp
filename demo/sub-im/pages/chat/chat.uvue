<template>
  <view class="page" :class="themeClass">
    <!-- 整栏自绘演示（?inputbar=custom）：#input-bar 插槽整栏替换默认输入栏，结构/样式全自绘，
         但键盘避让/面板互斥/录音/禁言/@/草稿链全部经 scope 契约由库内保持。
         插槽有无必须在页面实例创建时确定（composer 在 setup 实例化），故用查询参数 + redirectTo 重进切换 -->
    <em-chat-page
      v-if="conversationId !== '' && useCustomInputBar"
      :conversation-id="conversationId"
      :chat-type="chatType"
      :title="sceneTitle"
      :show-action="!sceneHideAction"
      :quick-replies="sceneQuickReplies"
      :quick-reply-mode="sceneQuickReplyMode"
      :extra-message-menus="sceneExtraMenus"
      @open-info="onOpenInfo"
      @message-menu="onSceneMessageMenu"
    >
      <template #custom-message="{ message }">
        <demo-card :message="message" fallback-text="[自定义消息]" @action="onCardAction" />
      </template>
      <template #input-bar="scope">
        <demo-custom-inputbar :scope="scope" />
      </template>
    </em-chat-page>
    <em-chat-page
      v-else-if="conversationId !== ''"
      :conversation-id="conversationId"
      :chat-type="chatType"
      :title="sceneTitle"
      :show-action="!sceneHideAction"
      :quick-replies="sceneQuickReplies"
      :quick-reply-mode="sceneQuickReplyMode"
      :extra-message-menus="sceneExtraMenus"
      @open-info="onOpenInfo"
      @message-menu="onSceneMessageMenu"
    >
      <!-- 场景演示：顶部业务横幅（#banner 固定位，不随消息滚动） -->
      <template #custom-message="{ message }">
        <demo-card :message="message" fallback-text="[自定义消息]" @action="onCardAction" />
      </template>

      <template #banner>
        <view v-if="sceneBanner" class="scene-banner">
          <view class="scene-banner__main">
            <text class="scene-banner__title">{{ scenario.chat.bannerTitle }}</text>
            <text class="scene-banner__desc">{{ scenario.chat.bannerDesc }}</text>
          </view>
          <view class="scene-banner__action" @click="onBannerTap">
            <text class="scene-banner__action-text">查看</text>
          </view>
        </view>
      </template>

      <!-- 场景演示：输入栏上方业务入口（#input-toolbar 固定位，随键盘上移）；点一下 = sendCustom 一条场景卡 -->
      <template #input-toolbar>
        <demo-composer-bar
          v-if="showComposer"
          :items="composerItems"
          :accent="scenario.accent"
          more-text="更多"
          @select="onComposerSelect"
          @more="panelVisible = true"
        />
      </template>

    </em-chat-page>

    <!-- Demo 能力入口：向当前会话注入 mock AI 流式回复（真实链路由 SDK onStreamMessage 驱动）；
         显隐由 demo/common/ai-stream-demo.ts 的 AI_STREAM_FAB_VISIBLE 控制 -->
    <view v-if="AI_STREAM_FAB_VISIBLE" class="ai-demo" @click="onAiDemo">
      <text class="ai-demo__text">AI 演示</text>
    </view>

    <!-- 场景演示开关入口（仅 ?scene=1；与 AI 演示浮钮上下错开） -->
    <view v-if="isDemo && conversationId !== ''" class="scene-fab" @click="panelVisible = true">
      <text class="scene-fab__text">场景开关</text>
    </view>

    <em-popup :visible="panelVisible" position="bottom" @update:visible="panelVisible = $event">
      <view class="scene-panel">
        <view class="scene-panel__head">
          <text class="scene-panel__title">场景能力开关 · {{ scenario.name }}</text>
          <view class="scene-panel__close" @click="panelVisible = false">
            <em-icon name="xmark-bold" :size="18" color="var(--em-text-secondary)" />
          </view>
        </view>

        <view class="scene-panel__stats">
          <text class="scene-panel__stat">本会话未读 {{ peerUnread }}</text>
          <text class="scene-panel__stat">总未读 {{ totalUnread }}</text>
        </view>

        <view
          v-for="option in sceneOptions"
          :key="option.key"
          class="scene-panel__row"
          @click="toggleSceneFlag(option.key)"
        >
          <view class="scene-panel__row-main">
            <text class="scene-panel__row-label">{{ option.label }}</text>
            <text class="scene-panel__row-desc">{{ option.desc }}</text>
          </view>
          <em-icon
            :name="sceneFlags[option.key] ? 'circle-checked-filled' : 'circle-empty'"
            :size="20"
            :color="sceneFlags[option.key] ? 'var(--em-primary-color)' : 'var(--em-icon-muted)'"
          />
        </view>

        <text class="scene-panel__section">发送自定义卡片（宿主 #custom-message 渲染）</text>
        <scroll-view scroll-x :show-scrollbar="false" class="scene-panel__cards">
          <view class="scene-panel__cards-track">
            <view
              v-for="card in scenario.chat.cards"
              :key="card.event"
              class="scene-panel__card"
              @click="sendSceneCard(card)"
            >
              <text class="scene-panel__card-label">{{ card.label }}</text>
              <text class="scene-panel__card-event">{{ card.event }}</text>
            </view>
          </view>
        </scroll-view>
        <view class="scene-panel__actions">
          <view class="scene-panel__btn" @click="sendSceneExtText">
            <text class="scene-panel__btn-text">{{ scenario.chat.textLabel }}</text>
          </view>
          <view class="scene-panel__btn" @click="insertSceneNotice">
            <text class="scene-panel__btn-text">{{ scenario.chat.noticeLabel }}</text>
          </view>
          <view class="scene-panel__btn" @click="sendUnregisteredCard">
            <text class="scene-panel__btn-text">未注册事件</text>
          </view>
        </view>
        <view class="scene-panel__actions">
          <view class="scene-panel__btn" @click="onToggleCustomInputBar">
            <text class="scene-panel__btn-text">{{ useCustomInputBar ? '恢复默认输入栏' : '整栏自绘输入栏' }}</text>
          </view>
        </view>
        <text class="scene-panel__hint">卡片只发 event/params/ext；聊天页把 #custom-message 交给 demo-card（宿主组件）渲染，UIKit 不含卡片样式。输入栏上方的「发订单/发病例/换手机号」等入口同样由宿主经 #input-toolbar 注入，点一下即发。未知事件走宿主兜底。「整栏自绘输入栏」演示 #input-bar 插槽：demo-custom-inputbar 全自绘结构，键盘/面板/录音/禁言/@ 行为经 scope 契约由库内保持（重进页面生效）。</text>
      </view>
    </em-popup>
  </view>
</template>

<script setup lang="ts">
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { computed, reactive, ref } from 'vue'
import { EmKit, CONVERSATION_TYPE, useConversationUnreadCount, useUnreadCounts } from '@/uni_modules/easemob-uikit-uni/libs'
import type { ConversationTypeValue, EmMessageItem, EmMessageMenuExtra, EmQuickReply, EmQuickReplyMode } from '@/uni_modules/easemob-uikit-uni/libs'
import { scenarioOf, type ScenarioCard, type ScenarioKey } from '@/common/scenario-catalog'
import { DEMO_UNKNOWN_EVENT, demoCardOf } from '@/common/demo-card-data'
import DemoCard from '@/components/demo-card/demo-card.vue'
import DemoComposerBar from '@/components/demo-composer-bar/demo-composer-bar.vue'
import DemoCustomInputbar from '@/components/demo-custom-inputbar/demo-custom-inputbar.vue'
import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'
import { useDemoTheme } from '@/common/theme'
import { AI_STREAM_DEMO_CONTENT, AI_STREAM_ERROR_CONTENT, AI_STREAM_FAB_VISIBLE, runMockAiStream } from '@/common/ai-stream-demo'

const { themeClass } = useDemoTheme()

const conversationId = ref('')
const chatType = ref<ConversationTypeValue>(CONVERSATION_TYPE.SINGLE_CHAT)
const scenarioKey = ref<ScenarioKey>('trade')
const scenario = computed(() => scenarioOf(scenarioKey.value))

// ===== 多场景能力演示（?scene=1）=====
// 演示开关只存在于 demo 层：进入聊天页后点「场景开关」实时改 props，不污染 UIKit 组件默认行为。
type SceneFlagKey = 'banner' | 'title' | 'hideAction' | 'quickReplies' | 'quickReplySend' | 'extraMenus' | 'composer'

interface SceneOption {
  key: SceneFlagKey
  label: string
  desc: string
}

const isDemo = ref(false)
const panelVisible = ref(false)
// 整栏自绘演示（?inputbar=custom）：#input-bar 插槽整栏替换默认输入栏。
// 插槽有无必须在页面实例创建时确定（chat-page 在 setup 检测并实例化 composer），
// 故不走场景开关的实时 toggle，用查询参数 + redirectTo 重进页面切换
const useCustomInputBar = ref(false)

const sceneFlags = reactive<Record<SceneFlagKey, boolean>>({
  banner: true,
  title: true,
  hideAction: true,
  quickReplies: true,
  quickReplySend: false,
  extraMenus: true,
  composer: true
})

const sceneOptions: SceneOption[] = [
  { key: 'banner', label: '顶部业务横幅', desc: '#banner 固定位，不随消息滚动' },
  { key: 'title', label: '场景标题', desc: 'title 按场景覆盖默认昵称' },
  { key: 'hideAction', label: '隐藏详情入口', desc: 'showAction=false，右上角 more 消失' },
  { key: 'quickReplies', label: '快捷回复条', desc: '输入栏上方常用语胶囊' },
  { key: 'quickReplySend', label: '常用语直接发送', desc: 'quickReplyMode="send"（默认 fill 填草稿）' },
  { key: 'extraMenus', label: '业务长按动作', desc: 'extraMessageMenus：按场景注入业务动作' },
  { key: 'composer', label: '输入栏业务入口', desc: '#input-toolbar：一点即发本场景卡片' }
]

const sceneTitle = computed(() => (isDemo.value && sceneFlags.title ? scenario.value.chat.title : ''))
const sceneHideAction = computed(() => isDemo.value && sceneFlags.hideAction)
const sceneBanner = computed(() => isDemo.value && sceneFlags.banner)
const sceneQuickReplies = computed<EmQuickReply[]>(() => (isDemo.value && sceneFlags.quickReplies ? scenario.value.chat.quickReplies : []))
const sceneQuickReplyMode = computed<EmQuickReplyMode>(() => (sceneFlags.quickReplySend ? 'send' : 'fill'))
const sceneExtraMenus = computed<EmMessageMenuExtra[]>(() => (isDemo.value && sceneFlags.extraMenus ? scenario.value.chat.extraMenus : []))

// 输入栏上方业务入口：直接由本场景卡片目录生成（entryLabel/entryIcon 属于宿主文案）
const showComposer = computed(() => isDemo.value && sceneFlags.composer)
const composerItems = computed<{ key: string; label: string; icon: EmIconName }[]>(() =>
  scenario.value.chat.cards.map((card) => ({ key: card.event, label: card.entryLabel, icon: card.entryIcon }))
)

// 单会话未读：传 ref，进会话清零后面板数字实时变化
const peerUnread = useConversationUnreadCount(conversationId)
const { conversationUnread: totalUnread } = useUnreadCounts()

function toggleSceneFlag(key: SceneFlagKey): void {
  sceneFlags[key] = !sceneFlags[key]
}

onLoad((options) => {
  // 只看是否已登录：断网/自动重连（reconnecting/closed）不踢回登录页，SDK 会自行重连
  if (EmKit.state.userId === '') {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  conversationId.value = (options?.['conversationId'] ?? '') as string
  const type = (options?.['chatType'] ?? '') as string
  chatType.value = type === CONVERSATION_TYPE.GROUP_CHAT ? CONVERSATION_TYPE.GROUP_CHAT : CONVERSATION_TYPE.SINGLE_CHAT
  scenarioKey.value = (options?.['scenario'] ?? 'trade') as ScenarioKey
  isDemo.value = options?.['scene'] === '1' || (options?.['scenario'] ?? '') !== ''
  useCustomInputBar.value = options?.['inputbar'] === 'custom'
})

// 整栏自绘演示切换：redirectTo 重进当前页（插槽有无必须页面级静态确定，见上注释）
function onToggleCustomInputBar(): void {
  const base = `/sub-im/pages/chat/chat?conversationId=${conversationId.value}&chatType=${chatType.value}&scenario=${scenarioKey.value}&scene=1`
  uni.redirectTo({ url: useCustomInputBar.value ? base : `${base}&inputbar=custom` })
}

// 聊天详情入口（em-chat-page 自绘 header 右上角 more 按钮）
function onOpenInfo(id: string) {
  uni.navigateTo({ url: `/sub-im/pages/chat-info/chat-info?conversationId=${id}&chatType=${chatType.value}` })
}

// ===== 多场景演示动作 =====
function onBannerTap(): void {
  uni.showModal({
    title: '业务横幅',
    content: `${scenario.value.name}：横幅由宿主渲染，点击可跳业务详情；这里只演示点击回调。`,
    showCancel: false
  })
}

// 业务长按动作：extraMessageMenus 命中后由宿主处理，载荷优先取卡片 ext 摘要
function onSceneMessageMenu(key: string, message: EmMessageItem): void {
  if (key !== 'scene-context') return
  const parts: string[] = []
  const push = (value: unknown): void => {
    if (typeof value === 'string' && value !== '') parts.push(value)
  }
  push(message.ext.title)
  push(message.ext.subtitle)
  push(message.ext.meta)
  const content = parts.length > 0 ? parts.join(' · ') : JSON.stringify(message.ext)
  uni.showModal({ title: scenario.value.chat.contextDialogTitle, content, showCancel: false })
}

// sendCustom：场景卡片（event + params + 结构化 ext）；呈现由宿主 #custom-message 决定
async function sendSceneCard(card: ScenarioCard): Promise<void> {
  try {
    await EmKit.sendCustom(conversationId.value, chatType.value, card.event, card.params, card.ext)
    panelVisible.value = false
  } catch (e) {
    uni.showToast({ title: '发送失败（需在线且会话可用）', icon: 'none' })
  }
}

// 输入栏业务入口：key 即卡片 event，点一下发一条（宿主自己的入口 → 宿主自己的 sendCustom）
function onComposerSelect(key: string): void {
  const card = scenario.value.chat.cards.find((item) => item.event === key)
  if (card == null) {
    uni.showToast({ title: '该入口未配置卡片', icon: 'none' })
    return
  }
  sendSceneCard(card)
}

// 未知事件：消息照常收发，但宿主卡片不认识它，走宿主兜底 [自定义消息]
async function sendUnregisteredCard(): Promise<void> {
  try {
    await EmKit.sendCustom(
      conversationId.value,
      chatType.value,
      DEMO_UNKNOWN_EVENT,
      { source: 'scene-lab' },
      {
        title: '宿主不认识的卡片',
        subtitle: '这个 event 没有对应的宿主渲染分支',
        fields: [{ label: '预期表现', value: '回落 [自定义消息]' }]
      }
    )
    panelVisible.value = false
  } catch (e) {
    uni.showToast({ title: '发送失败（需在线且会话可用）', icon: 'none' })
  }
}

// 卡片行动按钮：宿主组件 emit action，业务行为（跳详情/同意/拒绝）由宿主接管
function onCardAction(key: string, message: EmMessageItem): void {
  const card = demoCardOf(message)
  const title = card != null ? card.title : message.customEvent
  uni.showModal({
    title: `卡片动作 · ${key}`,
    content: `${title}\n事件 ${message.customEvent}（数据由宿主 demo-card 解析，行为由宿主接管）`,
    showCancel: false
  })
}

// sendText 业务 ext：业务上下文随消息带给对端
async function sendSceneExtText(): Promise<void> {
  try {
    await EmKit.sendText(
      conversationId.value,
      chatType.value,
      scenario.value.chat.textContent,
      undefined,
      undefined,
      scenario.value.chat.extraExt
    )
    panelVisible.value = false
  } catch (e) {
    uni.showToast({ title: '发送失败（需在线且会话可用）', icon: 'none' })
  }
}

// insertLocalNotice：只落本地的系统提示灰条（场景状态/转接提示）
function insertSceneNotice(): void {
  EmKit.insertLocalNotice(conversationId.value, chatType.value, scenario.value.chat.noticeText)
  panelVisible.value = false
}

// ===== AI 流式演示 =====
// 真实接入：业务服务端经环信 RESTful 下发流式消息 → SDK onStreamMessage → UIKit 自动合批渲染。
// 这里用 mock 分片注入当前会话，演示光标 / 终态 / 异常三种状态。
let stopStream: (() => void) | null = null

function startAiDemo(endStatus: 'completed' | 'error') {
  if (conversationId.value === '') return
  stopStream?.()
  stopStream = runMockAiStream({
    conversationId: conversationId.value,
    chatType: chatType.value,
    content: endStatus === 'error' ? AI_STREAM_ERROR_CONTENT : AI_STREAM_DEMO_CONTENT,
    endStatus
  })
}

function onAiDemo() {
  if (conversationId.value === '') return
  uni.showActionSheet({
    itemList: ['AI 流式回复（模拟）', '流式异常中断', '停止当前演示'],
    success: (res) => {
      if (res.tapIndex === 0) {
        startAiDemo('completed')
      } else if (res.tapIndex === 1) {
        startAiDemo('error')
      } else {
        stopStream?.()
        stopStream = null
      }
    }
  })
}

onUnload(() => {
  stopStream?.()
  stopStream = null
})
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-chat-bg);
}

/* Demo 能力入口：悬浮在引用条/快捷回复条之上、消息列表右下角（仅 demo 工程，不进 UIKit 组件） */
.ai-demo {
  position: absolute;
  right: 12px;
  bottom: 150px;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  border-radius: 16px;
  background-color: var(--em-primary-color);
  opacity: 0.92;
}

.ai-demo__text {
  font-size: 13px;
  color: #ffffff;
  line-height: 32px;
}

/* ===== 多场景能力演示（仅 demo 工程，不进 UIKit） ===== */
.scene-fab {
  position: absolute;
  right: 12px;
  bottom: 194px;
  z-index: 21;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  border-color: var(--em-border-color);
  background-color: var(--em-bg-elevated);
}

.scene-fab__text {
  font-family: var(--em-font-family);
  font-size: 12px;
  line-height: 32px;
  color: var(--em-text-primary);
}

/* 顶部业务横幅（#banner 宿主内容） */
.scene-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  background-color: var(--em-bg-secondary);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--em-divider-color);
  flex-shrink: 0;
}

.scene-banner__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.scene-banner__title {
  font-family: var(--em-font-family);
  font-size: 13px;
  line-height: 18px;
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-banner__desc {
  font-family: var(--em-font-family);
  font-size: 11px;
  line-height: 16px;
  color: var(--em-text-tertiary);
}

.scene-banner__action {
  flex-shrink: 0;
  margin-left: 12px;
  padding: 4px 10px;
  border-radius: 999px;
  background-color: var(--em-bg-active);
}

.scene-banner__action-text {
  font-family: var(--em-font-family);
  font-size: 12px;
  line-height: 16px;
  color: var(--em-primary-color);
}

/* 场景开关面板 */
.scene-panel {
  display: flex;
  flex-direction: column;
  padding: 8px 16px 16px;
  background-color: var(--em-bg-elevated);
}

.scene-panel__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
}

.scene-panel__title {
  font-family: var(--em-font-family);
  font-size: 15px;
  line-height: 22px;
  font-weight: var(--em-font-weight-semibold);
  color: var(--em-text-primary);
}

.scene-panel__close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scene-panel__stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  border-radius: 8px;
  background-color: var(--em-bg-secondary);
}

.scene-panel__stat {
  font-family: var(--em-font-family);
  font-size: 12px;
  line-height: 16px;
  color: var(--em-text-secondary);
  margin-right: 16px;
}

.scene-panel__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 9px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--em-divider-color);
}

.scene-panel__row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 12px;
}

.scene-panel__row-label {
  font-family: var(--em-font-family);
  font-size: 14px;
  line-height: 20px;
  color: var(--em-text-primary);
}

.scene-panel__row-desc {
  font-family: var(--em-font-family);
  font-size: 11px;
  line-height: 16px;
  color: var(--em-text-tertiary);
}

.scene-panel__section {
  margin-top: 12px;
  font-family: var(--em-font-family);
