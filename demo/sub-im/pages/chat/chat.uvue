<template>
  <view class="page">
    <em-chat-page v-if="conversationId !== ''" :conversation-id="conversationId" @open-info="onOpenInfo" />
  </view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { ref } from 'vue'
import { EmKit, CONNECTION_STATUS } from '@/uni_modules/easemob-uikit-uni/libs'

const conversationId = ref('')

onLoad((options) => {
  if (EmKit.state.status !== CONNECTION_STATUS.ONLINE) {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  const id = (options?.['conversationId'] ?? '') as string
  conversationId.value = id
})

// 聊天详情入口（em-chat-page 自绘 header 右上角 more 按钮）
function onOpenInfo(id: string) {
  uni.navigateTo({ url: `/sub-im/pages/chat-info/chat-info?conversationId=${id}` })
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}
</style>
