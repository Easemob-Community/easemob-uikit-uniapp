  margin-top: 2px;
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-11);
  line-height: 16px;
  color: var(--em-text-tertiary);
}

.seed__form {
  display: flex;
  flex-direction: column;
  padding: 0 var(--em-spacing-4) var(--em-spacing-2);
  background-color: var(--em-bg-base);
}

.seed__input {
  height: 40px;
  margin-top: var(--em-spacing-2);
  padding: 0 var(--em-spacing-3);
  border-radius: var(--em-radius);
  background-color: var(--em-bg-secondary);
  color: var(--em-text-primary);
  font-size: var(--em-font-size-13);
}

.seed__body {
  flex: 1;
  height: 0;
}

.seed__group {
  display: flex;
  flex-direction: column;
  margin: var(--em-spacing-3) var(--em-spacing-4) 0;
  padding: var(--em-spacing-3);
  border-radius: 12px;
  background-color: var(--em-bg-base);
}

.seed__group-title {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-13);
  line-height: 19px;
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-primary);
}

.seed__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: var(--em-spacing-2);
}

.seed__btn {
  flex: 1;
  height: 36px;
  margin-right: var(--em-spacing-2);
  border-radius: var(--em-radius);
  background-color: var(--em-primary-color);
  color: var(--em-text-inverse);
  font-size: var(--em-font-size-13);
}

.seed__btn--plain {
  background-color: var(--em-bg-secondary);
  color: var(--em-text-primary);
}

.seed__btn--wide {
  margin-top: var(--em-spacing-2);
  margin-right: 0;
}

.seed__log-box {
  display: flex;
  flex-direction: column;
  margin: var(--em-spacing-3) var(--em-spacing-4);
  padding: var(--em-spacing-3);
  border-radius: 12px;
  background-color: var(--em-bg-base);
}

.seed__log-line {
  margin-top: 4px;
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-11);
  line-height: 16px;
  color: var(--em-text-secondary);
}

.seed__log-line--empty {
  color: var(--em-text-tertiary);
}

.seed__log {
  height: 132px;
  margin-top: 4px;
}
</style>
