  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-bg-secondary);
}

.seed__bar {
  display: flex;
  flex-direction: column;
  padding: var(--em-spacing-3) var(--em-spacing-4);
  background-color: var(--em-bg-base);
}

