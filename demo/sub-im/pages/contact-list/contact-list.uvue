<template>
  <view class="page" :class="themeClass">
    <em-contact-list-page :watermark="watermarkText" @select="onSelect" @back="onBack" />
  </view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { EmKit, CONNECTION_STATUS, CONVERSATION_TYPE } from '@/uni_modules/easemob-uikit-uni/libs'
import { useDemoTheme } from '@/common/theme'
import { useDemoWatermark } from '@/common/watermark-demo'

const { themeClass } = useDemoTheme()
// 组件级水印（M2.27）：开关在「我的」页；关闭时为空串
const { text: watermarkText } = useDemoWatermark()

onLoad(() => {
  if (EmKit.state.status !== CONNECTION_STATUS.ONLINE) {
    uni.reLaunch({ url: '/pages/login/login' })
  }
})

// 预热（对齐会话页点击范式）：跳转前 fire-and-forget 进入会话与历史拉取
function onSelect(userId: string) {
  EmKit.enterConversation(userId, CONVERSATION_TYPE.SINGLE_CHAT).catch(() => {})
  EmKit.loadHistory(userId, CONVERSATION_TYPE.SINGLE_CHAT).catch(() => {})
  uni.navigateTo({ url: `/sub-im/pages/chat/chat?conversationId=${userId}&chatType=${CONVERSATION_TYPE.SINGLE_CHAT}` })
}

function onBack(): void {
  uni.navigateBack({ delta: 1 })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-conversation-list-bg);
}
</style>
