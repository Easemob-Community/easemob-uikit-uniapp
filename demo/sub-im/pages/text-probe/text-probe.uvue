<script setup lang="ts">
import { useDemoTheme } from '@/common/theme'

const { themeClass } = useDemoTheme()

// 与真机被裁消息同款的混合文本（CJK + 空格 + 拉丁），bubble 宽度下稳定折 2 行
const TEXT_MIXED = '你好，这是一条来自 Vue3 Demo 的单聊测试消息'
// 4 行以上长文本：检验行尾缺字是否每行都发生
const TEXT_LONG = '结构治理冒烟测试二零二六年十月十四日北京时间下午两点五十一分发送的长文本消息用来验证多行累计误差是否逐行放大'
const TEXT_SHORT = '短消息'
</script>

