  margin-top: 8px;
  font-family: var(--em-font-family);
  font-size: 13px;
  line-height: 20px;
  color: var(--em-text-secondary);
}

.cards__status {
  margin-top: 8px;
  font-family: var(--em-font-family);
  font-size: 11px;
  line-height: 16px;
  color: var(--em-text-tertiary);
}

.cards__group {
  display: flex;
  flex-direction: column;
  margin: 16px 16px 0;
}

.cards__group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
}

.cards__group-name {
  font-family: var(--em-font-family);
  font-size: 14px;
  line-height: 20px;
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-primary);
}

.cards__group-type {
  margin-left: 8px;
  padding: 1px 6px;
  border-radius: 4px;
  background-color: var(--em-bg-secondary);
  font-family: var(--em-font-family);
  font-size: 10px;
  line-height: 16px;
  color: var(--em-text-secondary);
}

.cards__item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 12px;
}

.cards__event {
  margin-top: 4px;
  font-family: var(--em-font-family);
  font-size: 10px;
  line-height: 14px;
  color: var(--em-text-tertiary);
}

.cards__footer {
  margin: 8px 16px 0;
