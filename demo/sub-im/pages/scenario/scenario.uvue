  display: flex;
  flex-direction: row;
  align-items: center;
  margin: var(--em-spacing-3) var(--em-spacing-4) 0;
  padding: var(--em-spacing-3) var(--em-spacing-4);
  border-radius: 12px;
  border-width: 1px;
  border-style: solid;
  border-color: var(--em-border-color);
  background-color: var(--em-bg-base);
}

.gallery__preview-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.gallery__preview-title {
  font-family: var(--em-font-family);
  font-size: 15px;
  line-height: 21px;
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-primary);
}

