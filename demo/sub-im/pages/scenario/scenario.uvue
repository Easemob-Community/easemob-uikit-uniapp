<template>
  <scroll-view scroll-y :class="['gallery', themeClass]">
    <view class="gallery__body">
      <view class="gallery__hero">
        <text class="gallery__title">IM 场景实验室</text>
        <text class="gallery__desc">同一个 em-chat-page，套进 6 种业务页面：业务上下文、卡片消息、快捷话术、长按动作、群公告与 @ 提及，都由宿主按场景组合。</text>
      </view>

      <view class="gallery__preview" @click="openCardPreview">
        <view class="gallery__preview-main">
          <text class="gallery__preview-title">自定义卡片预览</text>
          <text class="gallery__preview-desc">14 种宿主自绘卡片 + 未注册回落，无需登录</text>
        </view>
        <text class="gallery__preview-arrow">›</text>
      </view>

      <view class="gallery__peer">
        <text class="gallery__label">单聊演示对象 userId</text>
        <input
          v-model="peerId"
          class="gallery__input"
          placeholder="输入聊天对象 userId"
          placeholder-class="gallery__placeholder"
        />
        <view v-if="recentPeers.length > 0" class="gallery__chips">
          <view
            v-for="peer in recentPeers"
            :key="peer.conversationId"
            class="gallery__chip"
            @click="peerId = peer.conversationId"
          >
            <text class="gallery__chip-text">{{ peer.name !== '' ? peer.name : peer.conversationId }}</text>
          </view>
        </view>
        <text class="gallery__hint">单聊场景使用此 userId；群聊场景（家校/社群）在详情页选择已有群组。</text>
      </view>

      <text class="gallery__section">选择场景 · 点卡片查看业务页并进入会话</text>

      <view
        v-for="item in SCENARIO_LIST"
        :key="item.key"
        class="gallery__card"
        @click="openDetail(item.key)"
      >
        <view class="gallery__icon" :style="`background-color: ${item.accent};`">
          <em-icon :name="item.icon" :size="24" color="#FFFFFF" />
        </view>
        <view class="gallery__card-main">
          <view class="gallery__card-head">
            <text class="gallery__card-name">{{ item.name }}</text>
            <text class="gallery__card-type">{{ item.chatType === 'groupChat' ? '群聊' : '单聊' }}</text>
          </view>
          <text class="gallery__card-tagline">{{ item.tagline }}</text>
          <text class="gallery__card-meta">{{ item.fields[0].value }} · {{ item.fields[1].value }}</text>
        </view>
        <text class="gallery__card-arrow">›</text>
      </view>

      <text class="gallery__footer">扩展位：业务页 →「在线沟通」→ em-chat-page；会话能力不落在业务页里，业务页只负责上下文与路由。</text>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { CONVERSATION_TYPE, EmKit } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmConversationItem } from '@/uni_modules/easemob-uikit-uni/libs'
import { SCENARIO_LIST, type ScenarioKey } from '@/common/scenario-catalog'
import { useDemoTheme } from '@/common/theme'

const { themeClass } = useDemoTheme()

const peerId = ref('')

const recentPeers = computed<EmConversationItem[]>(() =>
  EmKit.conversations.items
    .filter((item) => item.chatType === CONVERSATION_TYPE.SINGLE_CHAT)
    .slice(0, 4)
)

onLoad(() => {
  const stored = uni.getStorageSync('demo.scene.peer') as string
  if (stored !== '') {
    peerId.value = stored
  } else if (recentPeers.value.length > 0) {
    peerId.value = recentPeers.value[0].conversationId
  }
})

function openCardPreview(): void {
  uni.navigateTo({ url: '/sub-im/pages/scenario/cards' })
}

function openDetail(key: ScenarioKey): void {
  const id = peerId.value.trim()
  if (id !== '') {
    uni.setStorageSync('demo.scene.peer', id)
  }
  uni.navigateTo({ url: `/sub-im/pages/scenario/detail?scenario=${key}` })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

