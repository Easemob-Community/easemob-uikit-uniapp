  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-bg-secondary);
}

/* 子项 margin 承担间距，避免 scroll-view 内容盒对 padding 的宽度解析问题 */
.gallery__body {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.gallery__hero {
  display: flex;
  flex-direction: column;
  margin: var(--em-spacing-4) var(--em-spacing-4) 0;
  padding: var(--em-spacing-4);
  border-radius: 12px;
  background-color: var(--em-bg-base);
}

.gallery__title {
  font-family: var(--em-font-family);
  font-size: 22px;
  line-height: 30px;
  font-weight: var(--em-font-weight-semibold);
  color: var(--em-text-primary);
}

.gallery__desc {
  margin-top: var(--em-spacing-2);
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-13);
  line-height: 20px;
  color: var(--em-text-secondary);
}

