  display: flex;
  flex-direction: row;
  align-items: center;
}

.detail__icon {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

