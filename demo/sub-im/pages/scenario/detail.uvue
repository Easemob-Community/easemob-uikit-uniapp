  font-size: var(--em-font-size-12);
  line-height: 16px;
  color: var(--em-text-primary);
}

.detail__step {
  margin-top: var(--em-spacing-2);
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-13);
  line-height: 19px;
  color: var(--em-text-secondary);
}

.detail__cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: var(--em-spacing-4) var(--em-spacing-4) 0;
  height: 48px;
  border-radius: 10px;
}

.detail__cta-text {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-16);
  line-height: 22px;
  font-weight: var(--em-font-weight-medium);
  color: #FFFFFF;
}

.detail__hint {
  margin: var(--em-spacing-2) var(--em-spacing-4) var(--em-spacing-5);
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-11);
  line-height: 17px;
  color: var(--em-text-tertiary);
}
</style>
