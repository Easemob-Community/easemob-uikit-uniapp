  font-size: var(--em-font-size-12);
  line-height: 18px;
  color: var(--em-text-tertiary);
}

/* 输入栏入口预览：模拟宿主插槽条在聊天页里的形态 */
.detail__composer {
  display: flex;
  flex-direction: column;
  margin-top: var(--em-spacing-3);
  border-radius: 10px;
  overflow: hidden;
  border-width: 1px;
  border-style: solid;
  border-color: var(--em-border-color);
}

.detail__fields {
  display: flex;
  flex-direction: column;
  margin-top: var(--em-spacing-1);
}

.detail__field {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 7px 0;
