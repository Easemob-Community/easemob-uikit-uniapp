  margin-top: 2px;
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-13);
  line-height: 19px;
  color: var(--em-text-secondary);
}

.detail__metric {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--em-spacing-3);
  padding: 9px var(--em-spacing-3);
  border-radius: 10px;
  background-color: var(--em-bg-secondary);
}

.detail__metric-label {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-12);
  line-height: 16px;
  color: var(--em-text-secondary);
}

.detail__metric-value {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-16);
  line-height: 22px;
  font-weight: var(--em-font-weight-semibold);
}

.detail__caps {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: var(--em-spacing-3);
}

.detail__cap {
  margin-right: var(--em-spacing-2);
  margin-bottom: var(--em-spacing-1);
  padding: 2px 8px;
  border-radius: 999px;
  background-color: var(--em-bg-active);
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-11);
  line-height: 15px;
  color: var(--em-primary-color);
}

.detail__section {
  display: flex;
  flex-direction: column;
  margin: var(--em-spacing-3) var(--em-spacing-4) 0;
  padding: var(--em-spacing-4);
  border-radius: 12px;
  background-color: var(--em-bg-base);
}

.detail__section-title {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-12);
  line-height: 16px;
  font-weight: var(--em-font-weight-medium);
  color: var(--em-text-secondary);
}

.detail__section-desc {
  margin-top: var(--em-spacing-2);
