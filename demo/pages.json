{
  "pages": [
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/conversation/conversation",
      "style": {
        "navigationBarTitleText": "会话列表",
        "navigationStyle": "custom",
        "app-plus": {
          "titleNView": false
        }
      }
    },
    {
      "path": "pages/contact/contact",
      "style": {
        "navigationBarTitleText": "通讯录",
        "navigationStyle": "custom",
        "app-plus": {
          "titleNView": false
        }
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "subPackages": [
    {
      "root": "sub-im",
      "name": "sub-im",
      "independent": false,
      "pages": [
        {
          "path": "pages/chat/chat",
          "style": {
            "navigationBarTitleText": "聊天",
            "navigationStyle": "custom",
            "app-plus": {
              "titleNView": false
            }
          }
        },
        {
          "path": "pages/chat-info/chat-info",
          "style": {
            "navigationBarTitleText": "聊天信息"
          }
        },
        {
          "path": "pages/contact-requests/contact-requests",
          "style": {
            "navigationBarTitleText": "新请求",
            "navigationStyle": "custom",
            "app-plus": {
              "titleNView": false
            }
          }
        },
        {
          "path": "pages/group/group",
          "style": {
            "navigationBarTitleText": "群组",
            "navigationStyle": "custom",
            "app-plus": {
              "titleNView": false
            }
          }
        },
        {
          "path": "pages/spike/spike",
          "style": {
            "navigationBarTitleText": "SDK 连通性 Spike"
          }
        },
        {
          "path": "pages/style-lab/style-lab",
          "style": {
            "navigationBarTitleText": "样式实验室"
          }
        },
        {
          "path": "pages/text-probe/text-probe",
          "style": {
            "navigationBarTitleText": "Text 测量探针"
          }
        }
      ]
    },
    {
      "root": "sub-sdk",
      "name": "sub-sdk",
      "independent": false,
      "pages": [
        {
          "path": "pages/placeholder/placeholder",
          "style": {
            "navigationBarTitleText": "SDK Loader"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/login/login": {
      "network": "all",
      "packages": ["sub-sdk"]
    }
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^em-([a-z-]+)-page$": "@/uni_modules/easemob-uikit-uni/components/pages/em-$1-page/em-$1-page.vue"
    }
  },
  "globalStyle": {
    "navigationBarTitleText": "easemob-uikit-uni",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F5F5F5"
  },
  "tabBar": {
    "color": "#919BA1",
    "selectedColor": "#009EFF",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/conversation/conversation",
        "text": "会话"
      },
      {
        "pagePath": "pages/contact/contact",
        "text": "联系人"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的"
      }
    ]
  }
}
