  "preloadRule": {
    "pages/login/login": {
      "network": "all",
      "packages": ["sub-sdk"]
    }
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^em-([a-z-]+)-page$": "@/uni_modules/easemob-uikit-uni/components/pages/em-$1-page/em-$1-page.vue"
    }
  },
  "globalStyle": {
    "navigationBarTitleText": "easemob-uikit-uni",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/conversation/conversation",
        "text": "会话",
        "iconPath": "static/tabbar/conversation.png",
        "selectedIconPath": "static/tabbar/conversation-active.png"
      },
      {
        "pagePath": "pages/contact/contact",
        "text": "联系人",
        "iconPath": "static/tabbar/contact.png",
