<template>
  <view class="page">
    <em-chat-page v-if="conversationId !== ''" :conversation-id="conversationId" />
  </view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { ref } from 'vue'
import { EmKit } from '@/uni_modules/easemob-uikit-uni/libs'

const conversationId = ref('')

onLoad((options) => {
  if (EmKit.state.status !== 'online') {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  const id = (options?.['conversationId'] ?? '') as string
  conversationId.value = id
  if (id !== '') {
    uni.setNavigationBarTitle({ title: id })
  }
})
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}
</style>
