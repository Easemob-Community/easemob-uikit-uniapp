<template>
  <view class="mine" :class="themeClass">
    <view class="mine__header">
      <em-avatar :src="avatar" :name="nick" :size="56" />
      <view class="mine__profile">
        <text class="mine__name">{{ nick }}</text>
        <text class="mine__status">{{ statusText }}</text>
      </view>
    </view>

    <view class="mine__group">
      <view class="mine__group-head">
        <text class="mine__group-title">深色模式</text>
      </view>
      <view
        class="mine__cell mine__cell--theme"
        v-for="option in themeOptions"
        :key="option.value"
        @click="onPickTheme(option.value)"
      >
        <view class="mine__cell-main">
          <text class="mine__cell-label">{{ option.label }}</text>
          <text class="mine__cell-desc">{{ option.description }}</text>
        </view>
        <em-icon
          :name="themeStore.preference === option.value ? 'circle-checked-filled' : 'circle-empty'"
          :size="20"
          :color="themeStore.preference === option.value ? 'var(--em-primary-color)' : 'var(--em-icon-muted)'"
        />
      </view>
    </view>

    <view class="mine__group">
      <view class="mine__group-head">
        <text class="mine__group-title">AI 流式消息（M2.13）</text>
      </view>
      <view class="mine__cell mine__cell--theme" @click="onToggleStream">
        <view class="mine__cell-main">
          <text class="mine__cell-label">流式输出开关</text>
          <text class="mine__cell-desc">{{ config.enableStreamMessage ? '已启用：分片逐字上屏 + 打字机光标（默认）' : '已禁用：等待完整消息一次性上屏' }}</text>
        </view>
        <em-icon
          :name="config.enableStreamMessage ? 'circle-checked-filled' : 'circle-empty'"
          :size="20"
          :color="config.enableStreamMessage ? 'var(--em-primary-color)' : 'var(--em-icon-muted)'"
        />
      </view>
      <view class="mine__cell" @click="onOpen('/sub-im/pages/style-lab/style-lab')">
        <text class="mine__cell-label">流式气泡演示（样式实验室）</text>
        <text class="mine__cell-arrow">›</text>
      </view>
    </view>

    <view class="mine__group">
      <view class="mine__cell" @click="onOpen('/sub-im/pages/scenario/scenario')">
        <text class="mine__cell-label">多场景能力演示</text>
        <text class="mine__cell-arrow">›</text>
      </view>
      <view class="mine__cell" @click="onOpen('/sub-im/pages/style-lab/style-lab')">
        <text class="mine__cell-label">样式实验室</text>
        <text class="mine__cell-arrow">›</text>
      </view>
      <view class="mine__cell" @click="onOpen('/sub-im/pages/spike/spike')">
        <text class="mine__cell-label">SDK 连通性 Spike</text>
        <text class="mine__cell-arrow">›</text>
      </view>
      <view class="mine__cell" @click="onExportLogs">
        <text class="mine__cell-label">导出调试日志</text>
        <text class="mine__cell-arrow">›</text>
      </view>
    </view>

    <view class="mine__footer">
      <button class="mine__logout" @click="onLogout">退出登录</button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { EmKit, avatarOf, displayNameOf, setConfig, useConfig, CONNECTION_STATUS, THEME_MODE } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmThemePreference } from '@/uni_modules/easemob-uikit-uni/libs'
import { useDemoTheme } from '@/common/theme'

// 默认 auto：跟随系统深浅色；light/dark 为宿主强制档（选择持久化在设备本地）
const { themeStore, themeClass, setTheme } = useDemoTheme()

// AI 流式消息运行时开关（演示 EmKitConfig.enableStreamMessage 的运行时覆盖能力）
const { config } = useConfig()

function onToggleStream() {
  const next = !config.enableStreamMessage
  setConfig({ enableStreamMessage: next })
  uni.showToast({ title: next ? '已开启流式输出' : '已关闭流式输出', icon: 'none' })
}

const userId = computed(() => EmKit.state.userId)
const nick = computed(() => displayNameOf(userId.value))
const avatar = computed(() => avatarOf(userId.value))

const themeOptions: { value: EmThemePreference, label: string, description: string }[] = [
  { value: THEME_MODE.AUTO, label: '跟随系统', description: '系统深色时自动切换' },
  { value: THEME_MODE.LIGHT, label: '浅色', description: '始终使用浅色' },
  { value: THEME_MODE.DARK, label: '深色', description: '始终使用深色' }
]

const statusText = computed(() => {
  switch (EmKit.state.status) {
    case CONNECTION_STATUS.ONLINE: return '已连接'
    case CONNECTION_STATUS.CONNECTING: return '连接中…'
    default: return '未连接'
  }
})

function onPickTheme(mode: EmThemePreference) {
  setTheme(mode)
}

function onOpen(url: string) {
  uni.navigateTo({ url })
}

async function onExportLogs() {
  const result = await EmKit.exportLogs()
  let content = ''
  if (result === 'download') {
    content = '日志文件已开始下载，请到浏览器下载目录查看'
  } else if (result === 'clipboard') {
    content = '写文件失败，日志全文已复制到剪贴板，粘贴到任意文本编辑器查看'
  } else {
    content = `日志已写入用户数据目录：\n${result}\n\n全文已同时复制到剪贴板，可直接粘贴导出`
  }
  uni.showModal({ title: '导出调试日志', content, showCancel: false })
}

async function onLogout() {
  try {
    await EmKit.logout()
  } catch (e) {}
  uni.reLaunch({ url: '/pages/login/login' })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.mine {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-bg-secondary);
}

.mine__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24px 16px;
  background-color: var(--em-bg-base);
}

.mine__profile {
  display: flex;
  flex-direction: column;
  margin-left: 12px;
}

.mine__name {
  font-size: 17px;
  font-weight: 600;
  color: var(--em-text-primary);
}

.mine__status {
  margin-top: 4px;
  font-size: 12px;
  color: var(--em-text-tertiary);
}

.mine__group {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  background-color: var(--em-bg-base);
}

.mine__group-head {
  padding: 12px 16px 4px;
}

.mine__group-title {
  font-size: 13px;
  color: var(--em-text-tertiary);
}

.mine__cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 16px;
}

.mine__cell--theme {
  height: auto;
  min-height: 56px;
  padding-top: 8px;
  padding-bottom: 8px;
}

.mine__cell-main {
  display: flex;
  flex-direction: column;
}

.mine__cell-label {
  font-size: 15px;
  color: var(--em-text-primary);
}

.mine__cell-desc {
  margin-top: 2px;
  font-size: 12px;
  color: var(--em-text-tertiary);
}

.mine__cell-arrow {
  font-size: 16px;
  color: var(--em-icon-muted);
}

.mine__footer {
  padding: 24px 16px;
}

.mine__logout {
  height: 40px;
  line-height: 40px;
  padding-top: 0;
  padding-bottom: 0;
  font-size: 15px;
  color: var(--em-danger-color);
  background-color: var(--em-bg-base);
  border-radius: 6px;
}
</style>
