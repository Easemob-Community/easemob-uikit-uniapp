<template>
  <view class="page">
    <em-conversation-page @select="onSelect" @menu="onMenu" />
  </view>
</template>

<script setup lang="ts">
import { onLoad, onShow } from '@dcloudio/uni-app'
import { EmKit, CONNECTION_STATUS, CONVERSATION_MENU_KEY } from '@/uni_modules/easemob-uikit-uni/libs'
import type { ConversationTypeValue } from '@/uni_modules/easemob-uikit-uni/libs'

function ensureLogin(): boolean {
  if (EmKit.state.status !== CONNECTION_STATUS.ONLINE) {
    uni.reLaunch({ url: '/pages/login/login' })
    return false
  }
  return true
}

onLoad(() => {
  if (!ensureLogin()) return
  EmKit.syncConversations().catch((e) => {
    console.error('[demo] syncConversations fail:', e)
  })
})

onShow(() => {
  if (!ensureLogin()) return
  EmKit.syncConversations().catch((e) => {
    console.error('[demo] syncConversations fail:', e)
  })
})

// 预热（对齐 TUIKit switchConversation 模式）：跳转前 fire-and-forget 发起进入会话与历史拉取，
// messageStore 是模块级 store，跳转动画期间数据已在路上；聊天页打开即有缓存可渲染
function preloadConversation(conversationId: string, chatType: ConversationTypeValue) {
  EmKit.enterConversation(conversationId, chatType).catch(() => {})
  EmKit.loadHistory(conversationId, chatType).catch(() => {})
}

function onSelect(conversationId: string, chatType: ConversationTypeValue) {
  preloadConversation(conversationId, chatType)
  uni.navigateTo({ url: `/sub-im/pages/chat/chat?conversationId=${conversationId}&chatType=${chatType}` })
}

// 「+」菜单：new-chat 已由 em-conversation-page 内置选人闭环（em-select-contact），
// create-group 跳群列表页（群列表页即建群入口，M2.9 Phase 4）
function onMenu(key: string) {
  if (key === CONVERSATION_MENU_KEY.CREATE_GROUP) {
    uni.navigateTo({ url: '/sub-im/pages/group/group' })
  }
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}
</style>
