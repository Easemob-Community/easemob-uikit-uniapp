<template>
  <view class="page" :class="themeClass">
    <!-- #title-extra 演示：场景实验室注入 ext.demoTag 的会话，标题旁渲染宿主业务标签 -->
    <em-conversation-page :watermark="watermarkText" @select="onSelect">
      <template #title-extra="{ ext }">
        <view v-if="tagOf(ext) !== ''" class="demo-tag">
          <text class="demo-tag__text">{{ tagOf(ext) }}</text>
        </view>
      </template>
    </em-conversation-page>
  </view>
</template>

<script setup lang="ts">
import { onLoad, onShow } from '@dcloudio/uni-app'
import { EmKit, useTabBarBadge } from '@/uni_modules/easemob-uikit-uni/libs'
import type { ConversationTypeValue } from '@/uni_modules/easemob-uikit-uni/libs'
import { useDemoTheme } from '@/common/theme'
import { tagOf } from '@/common/presentation-demo'
import { useDemoWatermark } from '@/common/watermark-demo'

const { themeClass } = useDemoTheme()
// 组件级水印（M2.27）：开关在「我的」页，文案 = 昵称 + userId；关闭时为空串
const { text: watermarkText } = useDemoWatermark()

// 底部 tabBar 角标：会话总未读 → index 0，联系人请求未读 → index 1（响应式，SDK 事件驱动）
const tabBarBadge = useTabBarBadge({ conversationIndex: 0, contactIndex: 1 })

// 只按「是否已登录」判断：断网/自动重连（status=reconnecting/closed）不应把用户踢回登录页，
// SDK 会自行重连；真正登出/未登录时 userId 才为空。
function ensureLogin(): boolean {
  if (EmKit.state.userId === '') {
    uni.reLaunch({ url: '/pages/login/login' })
    return false
  }
  return true
}

onLoad(() => {
  if (!ensureLogin()) return
  // em-conversation-page 默认 autoSync=true，首次挂载自拉快照；
  // onShow 的补同步仍由本页负责（组件拿不到页面级 onShow）
})

onShow(() => {
  // 从聊天页/二级页返回时补同步：非 tab 页里 setTabBarBadge 会被平台拒绝（"not TabBar page"）
  tabBarBadge.sync()
  if (!ensureLogin()) return
  EmKit.syncConversations().catch((e) => {
    console.error('[demo] syncConversations fail:', e)
  })
})

// 预热（对齐 TUIKit switchConversation 模式）：跳转前 fire-and-forget 发起进入会话与历史拉取，
// messageStore 是模块级 store，跳转动画期间数据已在路上；聊天页打开即有缓存可渲染
function preloadConversation(conversationId: string, chatType: ConversationTypeValue) {
  EmKit.enterConversation(conversationId, chatType).catch(() => {})
  EmKit.loadHistory(conversationId, chatType).catch(() => {})
}

function onSelect(conversationId: string, chatType: ConversationTypeValue) {
  preloadConversation(conversationId, chatType)
  uni.navigateTo({ url: `/sub-im/pages/chat/chat?conversationId=${conversationId}&chatType=${chatType}` })
}
</script>

<style>
@import '@/uni_modules/easemob-uikit-uni/libs/style/variables.css';

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--em-conversation-list-bg);
}

/* #title-extra 演示标签：场景实验室「业务资料注入」开启后，注入 ext.demoTag 的会话标题旁展示 */
.demo-tag {
  margin-left: 6px;
  padding: 1px 6px;
  border-radius: 999px;
  background-color: var(--em-bg-active);
  flex-shrink: 0;
}

.demo-tag__text {
  font-family: var(--em-font-family);
  font-size: var(--em-font-size-10);
  line-height: 14px;
  color: var(--em-primary-color);
}
</style>
