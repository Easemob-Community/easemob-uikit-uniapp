<script setup lang="ts">
import { useTheme, useLocale, themeStore } from '@/uni_modules/easemob-uikit-uni/libs'
import type { EmIconName } from '@/uni_modules/easemob-uikit-uni/components/em-icon/em-icons'

const { themeClass, setTheme } = useTheme()
const { t, setLocale } = useLocale()

const iconNames: EmIconName[] = [
  'back', 'search', 'plus', 'mic', 'image', 'camera', 'paperclip', 'paperplane',
  'sound', 'videocam', 'checkmarkempty', 'info', 'download', 'more', 'trash', 'undo'
]

function toggleTheme() {
  setTheme(themeStore.mode === 'light' ? 'dark' : 'light')
}

function toggleLocale() {
  setLocale(themeStore.locale === 'zh-CN' ? 'en' : 'zh-CN')
}
</script>

